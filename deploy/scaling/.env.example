# Copy outside the repository. The referenced files contain the actual secrets.
WOS_SHARED_SECRETS_DIR=/absolute/path/to/external/wos-secrets
WOS_BOOTSTRAP_TENANT_ID=0199ff31-0000-7000-8000-000000000002
WOS_BOOTSTRAP_TENANT_NAME=Production workspace
WOS_POSTGRES_CATALOG_SCHEMA=wos_control
WOS_LOCAL_PRINCIPAL_ID=operator
WOS_PUBLIC_HOST=wos.localhost
WOS_SHARED_HTTPS_PORT=8443
WOS_POSTGRES_MAX_OPEN_CONNECTIONS=8
# Profiles default to 1 complete process or 4 API+worker processes.
# Override only when changing the combined count (e.g. 4 APIs + 2 workers).
# WOS_DEPLOYMENT_EXPECTED_PROCESSES=6
WOS_DEPLOYMENT_DATABASE_CONNECTION_BUDGET=80
WOS_DEPLOYMENT_RESERVED_CONNECTIONS=20
# Single process starts without deliveries unless explicitly configured/enabled.
WOS_DELIVERY_WORKER_ENABLED=false
WOS_DELIVERY_WORKER_CONCURRENCY=4
# Optional reviewed endpoint JSON and secret-ref -> secret JSON map.
# Keep actual values only in the protected external environment/secret manager.
WOS_WEBHOOK_ENDPOINTS=
WOS_WEBHOOK_SECRETS=
# HTTP ceiling applies per API process; delivery ceilings use shared durable claims.
# Set a ceiling to 0 to disable that optional policy.
WOS_HTTP_MAX_INFLIGHT_PER_TENANT=32
WOS_DELIVERY_MAX_INFLIGHT_PER_TENANT=4
WOS_DELIVERY_MAX_INFLIGHT_PER_ENDPOINT=2
WOS_DEPLOYMENT_MANAGED_BACKUPS=false
