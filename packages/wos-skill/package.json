{
  "name": "@a1b3rt0m3rcad0/wos-skill",
  "version": "0.3.0",
  "description": "Portable WOS contract coordination, delegation, continuity, review and local workspace skills",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "wosCompatibility": {
    "service": "0.3.0",
    "httpApi": "v1",
    "snapshotSchema": 1,
    "workProtocol": "signed_contracts_v2",
    "workspaceSchema": 2,
    "supportedWorkProtocols": [
      "contracts_v1",
      "signed_contracts_v2"
    ],
    "supportedWorkspaceSchemas": [
      1,
      2
    ]
  },
  "bin": {
    "wos-skill": "bin/wos-skill.mjs"
  },
  "files": [
    "bin",
    "lib",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/A1b3rt0M3rcad0/wos.git",
    "directory": "packages/wos-skill"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "keywords": [
    "wos",
    "agent-skills",
    "mcp",
    "codex",
    "claude",
    "hermes",
    "openclaw"
  ]
}
