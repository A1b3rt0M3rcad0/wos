{
  "name": "@a1b3rt0m3rcad0/wos-cli",
  "version": "0.3.0",
  "description": "Native Go WOS and wosctl CLI for Linux and Windows x64; install agent skills without Node-powered logic",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "wos": "bin/wos.mjs",
