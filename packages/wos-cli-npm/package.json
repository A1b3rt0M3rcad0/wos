  },
  "files": [
    "bin",
    "lib",
    "native",
    "schemas",
    "release.json",
    "third-party-notices",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/A1b3rt0M3rcad0/wos.git",
