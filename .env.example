# Local development: cp .env.example .env && docker compose up --build -d
# Open http://localhost:8080/app/ and use the bootstrap token below to sign in.
# This public example token is for localhost only. Replace it for a shared instance.
WOS_HTTP_PORT=8080
WOS_BOOTSTRAP_TOKEN=wos-local-development-bootstrap-token-change-for-shared-instances
WOS_BOOTSTRAP_NAMESPACE_ID=0199ff31-0000-7000-8000-000000000001
WOS_BOOTSTRAP_NAMESPACE_NAME=Main
WOS_LOCAL_PRINCIPAL_ID=operator

# SQLite persists in the wos_data volume and requires no external database.
WOS_STORAGE_DRIVER=sqlite
WOS_POSTGRES_DSN=
WOS_MCP_ENABLED=true

# Optional PostgreSQL: COMPOSE_PROFILES=postgres, WOS_STORAGE_DRIVER=postgres,
# WOS_POSTGRES_DSN=postgres://wos:wos-local-postgres@postgres:5432/wos?sslmode=disable
COMPOSE_PROFILES=
WOS_POSTGRES_PASSWORD=wos-local-postgres

# Optional signed work: set an independently generated base64 Ed25519 seed here,
# then WOS_SERVER_SIGNING_SEED_ENV=WOS_SERVER_SIGNING_SEED.
# No shared signing key is provisioned by this example. Activate per Namespace
# explicitly after enrollment and protocol preflight (docs/signed-protocol-cutover.md).
WOS_SERVER_SIGNING_SEED_ENV=
WOS_SERVER_SIGNING_SEED=
WOS_SIGNED_ACCEPTANCE_FLOOR=direct

# Optional HTTP bounds; defaults work unchanged for the local quick-start.
# Durations require units. These reference values are not an availability SLA.
WOS_HTTP_READ_HEADER_TIMEOUT=5s
WOS_HTTP_READ_TIMEOUT=30s
WOS_HTTP_REQUEST_TIMEOUT=15s
WOS_HTTP_WRITE_TIMEOUT=45s
WOS_HTTP_IDLE_TIMEOUT=60s
WOS_HTTP_MAX_HEADER_BYTES=65536
WOS_HTTP_MAX_INFLIGHT_REQUESTS=128
WOS_MAX_CONNECTIONS=256
WOS_SHUTDOWN_TIMEOUT=15s
