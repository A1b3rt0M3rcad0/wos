# Operator-owned file: chmod 0600, never commit its populated copy.
WOS_BACKUP_ROOT=/private/wos-backups
WOS_BACKUP_SOURCE_COMMIT=REVIEWED_40_CHARACTER_DEPLOYED_GIT_SHA
WOS_BACKUP_PRODUCT_VERSION=DEPLOYED_VERSION
WOS_BACKUP_BACKEND=postgres
WOS_BACKUP_SCHEMA=public
WOS_POSTGRES_DSN=postgres://backup_operator:REPLACE@database:5432/wos?sslmode=verify-full
# For SQLite use WOS_BACKUP_BACKEND=sqlite and set WOS_BACKUP_SQLITE=/data/wos.db.
