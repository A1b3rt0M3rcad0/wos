+func TestSQLiteDocumentaryRecordsSurviveRestart(t *testing.T) {
+	ctx := context.Background()
+	path := filepath.Join(t.TempDir(), "wos.db")
+	store, err := Open(path, Options{BusyTimeout: time.Second, MigrateOnOpen: true})
+	if err != nil {
